// Buildings stand on a planet's surface. `radius`: footprint in metres.
// `group`: build-menu row (Economy, Production, Research, Defence, Sensors).
// `core`: a player who has no core building (and no colonizer) left is defeated.
// `extracts`: must be placed on a resource deposit and mines it at `rate` per second.
// `income`: resources per second while finished (metal, crystal, gas).
// `requires`: finished buildings the owner needs before this one can be started.
// `tech`: research needed first (data/research.ron). `research`: runs research projects.
// Armour class defaults to Structure. `aura`: shield / repair field for own things in `radius`.
// `sensors`: see data/units.ron. `tags`: targets for research effects ("building" is automatic).
[
    // ------------------------------------------------------------------ economy
    (
        id: "command_center",
        name: "Command Center",
        description: "Planetary headquarters. Trains drones, houses 10 and yields a little metal and crystal.",
        group: Economy,
        cost: (metal: 400, crystal: 100),
        time: 90.0,
        hp: 2000.0,
        armor: 1.0,
        radius: 7.0,
        pop: 10,
        income: (metal: 1.5, crystal: 0.5),
        trains: ["drone"],
        sensors: (sight: 40.0, radar: 50.0),
        core: true,
        tags: ["core"],
        model: "command_center",
    ),
    (
