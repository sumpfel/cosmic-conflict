// The research tree. Researched in a Research Lab (one project at a time per lab, up to five
// queued); several labs research in parallel. A tech needs its `requires` (always lower tiers).
// Units / buildings list the techs that unlock them in their own `tech` field.
//
// Effects change a stat of every unit / building whose tags match (`tags: []` = everything):
//   value = (base + Σ add) × Π mul
// Stats: Hp, Armor, Shield, ShieldRegen, Regen (self-repair hp/s), Damage, Range, Cooldown,
// Splash, Speed, Sight, Radar, Seismic, Deep, Detect, Aura, Extraction, Income, Pop.
// `damage: Some(Kind)` limits a weapon stat to weapons of that damage kind.
// Upgrades never give a sensor to something that has none (they only scale existing ones).
[
    // ================================================================== weapons
    (
        id: "ballistics",
        name: "Advanced Ballistics",
        description: "Better propellants and fire control for every gun. Unlocks the Siege Mortar.",
        field: Weapons, tier: 1,
        cost: (metal: 150, crystal: 50), time: 35.0,
        effects: [
            (stat: Damage, mul: 1.15, damage: Some(Kinetic)),
            (stat: Range, mul: 1.1, damage: Some(Kinetic)),
        ],
    ),
    (
        id: "lasers",
        name: "Focused Lasers",
        description: "Compact high-energy emitters. Unlocks the Laser Turret.",
        field: Weapons, tier: 1,
        cost: (metal: 120, crystal: 90), time: 35.0,
        effects: [(stat: Damage, mul: 1.1, damage: Some(Laser))],
    ),
    (
        id: "guided_missiles",
        name: "Guided Missiles",
        description: "Seeker heads for rockets. Unlocks Lancers, the Missile Battery and the Missile Frigate.",
        field: Weapons, tier: 1,
        cost: (metal: 150, crystal: 100, gas: 20), time: 40.0,
        effects: [(stat: Range, mul: 1.1, damage: Some(Explosive))],
    ),
    (
        id: "depleted_uranium",
        name: "Depleted-Uranium Rounds",
        description: "Dense penetrators for every kinetic weapon.",
        field: Weapons, tier: 2,
        cost: (metal: 220, crystal: 120, gas: 30), time: 50.0,
        requires: ["ballistics"],
        effects: [(stat: Damage, mul: 1.2, damage: Some(Kinetic))],
    ),
    (
        id: "phased_lasers",
        name: "Phased Lasers",
        description: "Capacitor banks that let lasers fire a quarter faster.",
        field: Weapons, tier: 2,
        cost: (metal: 200, crystal: 160), time: 50.0,
        requires: ["lasers"],
        effects: [(stat: Cooldown, mul: 0.8, damage: Some(Laser))],
    ),
    (
        id: "shaped_charges",
        name: "Shaped-Charge Warheads",
        description: "More damage and a wider blast for missiles, bombs and shells.",
        field: Weapons, tier: 2,
        cost: (metal: 220, crystal: 140, gas: 40), time: 50.0,
        requires: ["guided_missiles"],
        effects: [
            (stat: Damage, mul: 1.2, damage: Some(Explosive)),
            (stat: Splash, mul: 1.3, damage: Some(Explosive)),
        ],
    ),
    (
        id: "ion_weapons",
        name: "Ion Disruption",
        description: "Weaponised EMP that collapses shields. Unlocks the Ion Disruptor.",
        field: Weapons, tier: 2,
        cost: (metal: 200, crystal: 200, gas: 60), time: 55.0,
        requires: ["lasers"],
        effects: [(stat: Damage, mul: 1.1, damage: Some(Ion))],
    ),
    (
        id: "railguns",
        name: "Railguns",
        description: "Electromagnetic acceleration: kinetic weapons reach much further.",
        field: Weapons, tier: 3,
        cost: (metal: 320, crystal: 220, gas: 60), time: 65.0,
        requires: ["depleted_uranium"],
        effects: [
            (stat: Range, mul: 1.2, damage: Some(Kinetic)),
            (stat: Damage, mul: 1.1, damage: Some(Kinetic)),
        ],
    ),
    (
        id: "plasma_weapons",
        name: "Plasma Containment",
        description: "Magnetic bottles for star-hot plasma. Unlocks the Plasma Cannon; with more research the Juggernaut and the Battlecruiser.",
        field: Weapons, tier: 3,
        cost: (metal: 350, crystal: 250, gas: 120), time: 70.0,
        requires: ["phased_lasers"],
    ),
    (
        id: "plasma_overcharge",
        name: "Plasma Overcharge",
        description: "Overdriven plasma bolts hit harder and splash wider.",
        field: Weapons, tier: 4,
        cost: (metal: 450, crystal: 350, gas: 200), time: 90.0,
        requires: ["plasma_weapons"],
        effects: [
            (stat: Damage, mul: 1.25, damage: Some(Plasma)),
            (stat: Splash, mul: 1.25, damage: Some(Plasma)),
        ],
    ),
    // ================================================================== armour
    (
        id: "composite_armor",
